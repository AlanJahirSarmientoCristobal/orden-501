[connection signal="pressed" from="Columnas/Secundario/Niveles/Nivel2" to="." method="_jugar_nivel" binds= [2]]
[connection signal="pressed" from="Columnas/Secundario/Niveles/Nivel3" to="." method="_jugar_nivel" binds= [3]]
[connection signal="pressed" from="Columnas/Secundario/Niveles/Reto/Caja/Jugar" to="." method="_jugar_reto"]
