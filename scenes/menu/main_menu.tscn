[node name="Controles" type="VBoxContainer" parent="Columnas/Secundario"]
layout_mode = 2
visible = false
theme_override_constants/separation = 10

[node name="Titulo" type="Label" parent="Columnas/Secundario/Controles"]
layout_mode = 2
theme_type_variation = &"Titulo"
theme_override_font_sizes/font_size = 24
text = "CÓMO JUGAR"

[node name="Texto" type="Label" parent="Columnas/Secundario/Controles"]
layout_mode = 2
theme_override_font_sizes/font_size = 14
text = "MAÑANA (pueblo): recorre el pueblo y compra insumos en el Mercado (carne, pollo, papas, verdura, pan) y la Cervecería (cerveza, refresco, hielo, Monster). Tienes dinero y almacén limitados, y algunos insumos caducan.\n\nJORNADA (restaurante): toma pedidos en las mesas, recoge los platillos en el pase de cocina o la barra, sirve y limpia las mesas antes de que se agote la paciencia. En el medio tiempo y con cada gol llegan olas de pedidos.\n\nFALTANTE: si un insumo se acaba, elige entre marcar el platillo como agotado, pedir urgente por teléfono u ofrecer un sustituto.\n\nCIERRE: revisa el reporte del día y compra mejoras.\n\nW A S D / Flechas: moverse\nShift: correr (gasta estamina; si se agota, espera a que se recupere)\nEspacio: interactuar (mantener para limpiar mesas)\nE: tablet (stock, cocina, reservaciones, avisos)\nQ: pedido urgente al proveedor\nR: asignar reservaciones\nI: inventario (en el pueblo)\nEsc: pausa"
autowrap_mode = 3
custom_minimum_size = Vector2(620, 0)

[node name="Creditos" type="Label" parent="."]
offset_left = 0.0
offset_top = 690.0
offset_right = 1280.0
offset_bottom = 710.0
theme_type_variation = &"Tenue"
theme_override_font_sizes/font_size = 12
text = "Alan Jahir Sarmiento Cristóbal · Luis Ángel Hernández Hernández · Optativa 1: Creación de Videojuegos · Gráficos temporales: Kenney (CC0)"
horizontal_alignment = 1

