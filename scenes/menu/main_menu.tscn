[node name="Texto" type="Label" parent="Columnas/Secundario/Niveles/Reto/Caja"]
layout_mode = 2
theme_override_colors/font_color = Color(1, 0.701961, 0.756863, 1)
theme_override_font_sizes/font_size = 13
text = "Una Gran Final con el balance original de Difícil: insumos caros, VIP muy impacientes, familias desde el inicio y sin mejoras. No afecta tu partida guardada."
autowrap_mode = 3
