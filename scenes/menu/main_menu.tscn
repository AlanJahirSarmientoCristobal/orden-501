[connection signal="pressed" from="Columnas/Izquierda/Principal/Salir" to="." method="_salir"]
[connection signal="pressed" from="Columnas/Secundario/Dificultad/Facil/Caja/Jugar" to="." method="_nueva_partida" binds= ["facil"]]
