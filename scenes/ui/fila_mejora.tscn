[gd_scene format=3]

[node name="FilaMejora" type="PanelContainer"]
theme_type_variation = &"PanelClaro"

[node name="Fila" type="HBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 8

[node name="Caja" type="VBoxContainer" parent="Fila"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 0

[node name="Titulo" type="Label" parent="Fila/Caja"]
layout_mode = 2
theme_override_font_sizes/font_size = 14

[node name="Descripcion" type="Label" parent="Fila/Caja"]
layout_mode = 2
theme_type_variation = &"Tenue"
theme_override_font_sizes/font_size = 11
autowrap_mode = 3
custom_minimum_size = Vector2(250, 0)

[node name="Comprar" type="Button" parent="Fila"]
layout_mode = 2
theme_override_font_sizes/font_size = 13
text = ""
custom_minimum_size = Vector2(110, 0)
